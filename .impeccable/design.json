      "css": ".ds-entry{display:flex;flex-direction:column;padding:4px 0 14px;color:var(--text);font:16px/1.65 var(--font-body);text-decoration:none;border-bottom:1px solid var(--border)}.ds-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;font-weight:500}.ds-heading svg{width:20px;height:20px;flex-shrink:0;color:var(--accent);transition:transform .18s ease}.ds-description{font-size:13px;line-height:1.8;color:var(--text-muted);margin-top:8px}.ds-entry:hover .ds-heading{color:var(--accent-strong)}.ds-entry:hover svg{transform:translateX(3px)}.ds-entry:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-heading svg{transition:none}}"
