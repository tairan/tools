      "html": "<nav class=\"ds-nav\" aria-label=\"工具分类\"><a href=\"#all\" aria-current=\"true\">全部工具 <span>11</span></a><a href=\"#text\">文本处理</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:8px 24px;border-bottom:1px solid var(--border);font:14px/1.65 var(--font-body)}.ds-nav a{display:inline-flex;align-items:center;gap:8px;min-height:48px;color:var(--text-muted);text-decoration:none;border-bottom:2px solid transparent}.ds-nav a[aria-current]{color:var(--accent-strong);border-color:var(--accent)}.ds-nav a:hover{color:var(--accent-strong)}.ds-nav span{font-size:12px}.ds-nav a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}"
